        "input.background": "#0A141E",
        "input.foreground": "#D0E8F0",
        "input.border": "#004858",
        "input.placeholderForeground": "#507080",
        "dropdown.background": "#0A141E",
        "dropdown.foreground": "#D0E8F0",
        "dropdown.border": "#004858",
        "list.activeSelectionBackground": "#003848",
        "list.activeSelectionForeground": "#00F5FF",
        "list.inactiveSelectionBackground": "#0A141E",
