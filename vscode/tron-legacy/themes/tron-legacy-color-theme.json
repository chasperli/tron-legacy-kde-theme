        "widget.shadow": "#000000",
        "focusBorder": "#00F5FF",
        "foreground": "#D0E8F0",
        "errorForeground": "#FF3030"
    },
    "tokenColors": [
        { "scope": "comment", "settings": { "foreground": "#507080", "fontStyle": "italic" } },
        { "scope": ["comment.block.documentation", "comment.line.documentation"], "settings": { "foreground": "#406070", "fontStyle": "italic" } },
        { "scope": "keyword", "settings": { "foreground": "#00F5FF" } },
        { "scope": ["keyword.control", "keyword.control.flow"], "settings": { "foreground": "#00F5FF" } },
        { "scope": "keyword.operator", "settings": { "foreground": "#0096A8" } },
        { "scope": "storage", "settings": { "foreground": "#00F5FF" } },
        { "scope": "storage.type", "settings": { "foreground": "#00BFFF" } },
        { "scope": "constant", "settings": { "foreground": "#FFB340" } },
        { "scope": "constant.numeric", "settings": { "foreground": "#FF9500" } },
        { "scope": "string", "settings": { "foreground": "#00E5CC" } },
        { "scope": "string.escape", "settings": { "foreground": "#00C8B4" } },
        { "scope": "entity.name.function", "settings": { "foreground": "#C8E6F0" } },
        { "scope": "entity.name.type", "settings": { "foreground": "#00BFFF" } },
        { "scope": "entity.name.class", "settings": { "foreground": "#00BFFF" } },
        { "scope": "entity.name.tag", "settings": { "foreground": "#00F5FF" } },
        { "scope": "entity.other.attribute-name", "settings": { "foreground": "#FFB340" } },
        { "scope": "variable", "settings": { "foreground": "#D0E8F0" } },
        { "scope": "variable.parameter", "settings": { "foreground": "#D0E8F0" } },
        { "scope": "support.function", "settings": { "foreground": "#00BFFF" } },
        { "scope": "support.type", "settings": { "foreground": "#00BFFF" } },
        { "scope": "support.class", "settings": { "foreground": "#00BFFF" } },
        { "scope": "meta.preprocessor", "settings": { "foreground": "#FF9500" } },
        { "scope": "meta.import", "settings": { "foreground": "#FF9500" } },
        { "scope": "invalid", "settings": { "foreground": "#FF3030", "fontStyle": "underline" } },
        { "scope": ["markup.heading", "markup.heading.setext"], "settings": { "foreground": "#00F5FF", "fontStyle": "bold" } },
        { "scope": "markup.italic", "settings": { "fontStyle": "italic" } },
        { "scope": "markup.bold", "settings": { "fontStyle": "bold" } },
        { "scope": "markup.inserted", "settings": { "foreground": "#00C8A0" } },
        { "scope": "markup.deleted", "settings": { "foreground": "#FF3030" } },
        { "scope": "markup.changed", "settings": { "foreground": "#FF9500" } },
        { "scope": "markup.inline.raw", "settings": { "foreground": "#00E5CC" } },
        { "scope": "markup.underline.link", "settings": { "foreground": "#00F5FF" } }
    ]
}
