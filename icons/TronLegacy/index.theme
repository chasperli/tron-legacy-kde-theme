[Icon Theme]
Name=Tron Legacy
Comment=Neon-cyan icon theme matching the Tron Legacy global theme
Inherits=breeze-dark,hicolor
Example=folder
FollowsColorScheme=false

Directories=places/scalable,devices/scalable,apps/scalable,mimetypes/scalable

[places/scalable]
Size=64
MinSize=8
MaxSize=512
Context=Places
Type=Scalable

[devices/scalable]
Size=64
MinSize=8
MaxSize=512
Context=Devices
Type=Scalable

[apps/scalable]
Size=64
MinSize=8
MaxSize=512
Context=Applications
Type=Scalable

[mimetypes/scalable]
Size=64
MinSize=8
MaxSize=512
Context=MimeTypes
Type=Scalable
